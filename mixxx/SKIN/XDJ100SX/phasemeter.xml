<!--
  XDJ network sync panel: CDJ-style beat lanes (master on top, this deck
  below, shared playhead, beats, numbered bars, hot cues, bars.beat
  countdown to the next hot cue) plus SYNC and MASTER. See sync/DESIGN.md.
-->
<Template>
  <WidgetGroup>
    <ObjectName>SyncPanel</ObjectName>
    <Layout>horizontal</Layout>
    <Size>me,84f</Size>
    <Children>

      <XdjBeatLanes>
        <ObjectName>BeatLanes</ObjectName>
        <Size>me,84f</Size>
      </XdjBeatLanes>

      <!-- SYNC: touch to toggle. MASTER: lit while this player is the
           automatic master (longest playing), not pressable. -->
      <WidgetGroup>
        <ObjectName>SyncButtons</ObjectName>
        <Layout>horizontal</Layout>
        <Size>168f,84f</Size>
        <Children>
          <PushButton>
            <ObjectName>SyncButton</ObjectName>
            <Size>68f,44f</Size>
            <NumberStates>2</NumberStates>
            <State><Number>0</Number><Text>SYNC</Text></State>
            <State><Number>1</Number><Text>SYNC</Text></State>
            <Connection>
              <ConfigKey>[XdjSync],sync</ConfigKey>
            </Connection>
          </PushButton>
          <PushButton>
            <ObjectName>MasterIndicator</ObjectName>
            <Size>80f,44f</Size>
            <NumberStates>2</NumberStates>
            <State><Number>0</Number><Text>MASTER</Text></State>
            <State><Number>1</Number><Text>MASTER</Text></State>
            <Connection>
              <ConfigKey>[XdjSync],master</ConfigKey>
              <ConnectValueFromWidget>false</ConnectValueFromWidget>
            </Connection>
          </PushButton>
        </Children>
      </WidgetGroup>

    </Children>
  </WidgetGroup>
</Template>
